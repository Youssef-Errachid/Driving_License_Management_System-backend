# =========================================
# DLMS Backend - Environment Configuration
# Copy this file to ".env" and fill in real values.
# Never commit the actual ".env" file.
# =========================================

# ---- MySQL Database ----
# Used by Spring Datasource (application.properties: spring.datasource.username/password)
# and by the MySQL container (MYSQL_ROOT_PASSWORD) in docker-compose.
DB_USERNAME=root
DB_PASSWORD=your_mysql_password

# Note: the DB name (dlms_db) and JDBC URL are hardcoded in application.properties
# / docker-compose (jdbc:mysql://mysql:3306/dlms_db...), not read from this file.

# ---- JWT Authentication ----
# Secret key used to sign/verify JWT tokens (jwt.secret in application.properties).
# Use a long, random, base64-safe string in real environments — never reuse this example.
JWT_SECRET=replace_with_a_long_random_secret_string

# Token validity duration in milliseconds (jwt.expiration).
# Defaults to 3600000 (1 hour) if not set.
JWT_EXPIRATION=3600000

# ---- Redis (used for Spring Cache) ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Cloudinary (image/file storage) ----
# Used for uploading files such as person photos (cloudinary.* properties).
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret